print(pd.read_sql("SELECT * FROM enrollments", conn))

query = """
SELECT c.course_name,
       s.student_name,
       e.grade
FROM enrollments e
JOIN students s
ON e.student_id = s.student_id
JOIN courses c
ON e.course_id = c.course_id
WHERE (e.course_id,e.grade) IN
(
SELECT course_id,
       MAX(grade)
FROM enrollments
GROUP BY course_id
)
"""

pd.read_sql(query, conn)

query = """
SELECT c.course_name,
       COUNT(*) AS total_students,
       SUM(CASE WHEN grade>=40 THEN 1 ELSE 0 END) AS passed_students,
       ROUND(
       100.0*SUM(CASE WHEN grade>=40 THEN 1 ELSE 0 END)/COUNT(*),
       2
       ) AS pass_rate
FROM enrollments e
JOIN courses c
ON e.course_id=c.course_id
GROUP BY c.course_name
"""

pd.read_sql(query, conn)

query = """
SELECT s.student_name,
       SUM(e.grade) AS total_marks
FROM enrollments e
JOIN students s
ON e.student_id=s.student_id
GROUP BY s.student_id,s.student_name
ORDER BY total_marks DESC
LIMIT 1
"""

pd.read_sql(query, conn)

query = """
SELECT s.student_name,
       COUNT(e.course_id) AS total_courses
FROM students s
JOIN enrollments e
ON s.student_id=e.student_id
GROUP BY s.student_id,s.student_name
HAVING COUNT(e.course_id)>1
"""

pd.read_sql(query, conn)

query = """
SELECT s.student_name,
       AVG(e.grade) AS average_grade
FROM students s
JOIN enrollments e
ON s.student_id=e.student_id
GROUP BY s.student_id,s.student_name
HAVING AVG(e.grade)>75
"""

pd.read_sql(query, conn)